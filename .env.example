# ============================================================
# TRIBO INVEST - AGENTE DE IA COMERCIAL
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# --- ANTHROPIC (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- META / INSTAGRAM ---
# Token de acesso da página do Instagram (Facebook Developer)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
# Token de verificação do webhook (você define - qualquer string segura)
META_VERIFY_TOKEN=triboinvest_webhook_secret_2024
# ID do número de WhatsApp Business (se usar WhatsApp também)
WHATSAPP_PHONE_NUMBER_ID=

# --- KOMMO CRM ---
# URL base da sua conta Kommo (ex: suaconta.kommo.com)
KOMMO_BASE_URL=https://suaconta.kommo.com
# Token de acesso da API Kommo (Long-lived token)
KOMMO_ACCESS_TOKEN=eyJxxxxxxxxxxxxxxxxxx
# ID do pipeline principal no Kommo
KOMMO_PIPELINE_ID=
# IDs dos estágios do pipeline (preencha após criar no Kommo)
KOMMO_STAGE_NOVO_LEAD=
KOMMO_STAGE_QUALIFICADO_TRIBO=
KOMMO_STAGE_QUALIFICADO_ORG_FIN=
KOMMO_STAGE_NAO_QUALIFICADO=

# --- SERVIDOR ---
PORT=3000
NODE_ENV=production
# URL pública do servidor (para configurar webhooks Meta)
SERVER_URL=https://seu-servidor.com

# --- SEGURANÇA ---
# Secret para validar assinatura dos webhooks Meta
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
