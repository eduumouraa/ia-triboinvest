# ============================================================
# TRIBO INVEST - AGENTE DE IA COMERCIAL
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# --- ANTHROPIC (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- META / INSTAGRAM ---
# Token de acesso da página do Instagram (Facebook Developer)
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx
# Token de verificação do webhook (você define - qualquer string segura)
META_VERIFY_TOKEN=triboinvest_webhook_secret_2024
# ID do número de WhatsApp Business (se usar WhatsApp também)
WHATSAPP_PHONE_NUMBER_ID=

# --- KOMMO CRM ---
# URL base da sua conta Kommo (ex: suaconta.kommo.com)
KOMMO_BASE_URL=https://suaconta.kommo.com
# Token de acesso da API Kommo (Long-lived token)
KOMMO_ACCESS_TOKEN=eyJxxxxxxxxxxxxxxxxxx
# ID do pipeline principal no Kommo
KOMMO_PIPELINE_ID=
# IDs dos estágios do pipeline (preencha após criar no Kommo)
KOMMO_STAGE_NOVO_LEAD=
KOMMO_STAGE_QUALIFICADO_TRIBO=
KOMMO_STAGE_QUALIFICADO_ORG_FIN=
KOMMO_STAGE_NAO_QUALIFICADO=
# Secret para autenticar webhooks enviados pelo Kommo ao nosso servidor
# Adicione este token como parâmetro na URL do webhook no Kommo:
# https://ia-triboinvest-production.up.railway.app/webhook/kommo?token=SEU_TOKEN
KOMMO_WEBHOOK_SECRET=tribo_kommo_secret_2024

# --- SERVIDOR ---
PORT=3000
NODE_ENV=production
# URL pública do servidor (para configurar webhooks Meta)
SERVER_URL=https://seu-servidor.com

# --- HUMANIZAÇÃO ---
# Delay mínimo em segundos antes de responder (simula leitura humana)
HUMANIZATION_DELAY_MIN=60
# Delay máximo em segundos
HUMANIZATION_DELAY_MAX=180
# Forçar delay mesmo em desenvolvimento (default: false)
HUMANIZATION_FORCE=false

# --- SEGURANÇA ---
# Secret para validar assinatura dos webhooks Meta
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Token para proteger as rotas /admin/*
ADMIN_TOKEN=tribo_admin_secret_2024

# --- ESCALAÇÃO PARA EDUARDO (Lead Quente) ---
# WhatsApp de Eduardo para receber notificações de lead quente
EDUARDO_WHATSAPP=5511999999999

# --- TELEGRAM (alternativa para notificação de lead quente) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LINKS DOS PRODUTOS ---
LINK_TRIBO_DO_INVESTIDOR=https://pay.hotmart.com/xxx
LINK_ORG_FINANCEIRA=https://pay.hotmart.com/yyy
